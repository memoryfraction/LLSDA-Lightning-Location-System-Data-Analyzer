<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net48;netstandard2.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    
    <!-- NuGet Package Metadata -->
    <PackageId>LightningLocationSystemDataAnalyzer-LLDSA</PackageId>
    <Version>1.4.1</Version>
    <Authors>Rong Fan | 樊荣</Authors>
    <Company>NUIST</Company>
    <Product>Lightning Location System Data Analyzer</Product>
    <Description>LLSDA (Lightning Location System Data Analyzer) is an open-source, cross-platform class library for analyzing lightning location system data. Provides statistical analysis and visualization of lightning time/space distribution. Supports .NET Framework 4.8 and .NET Standard 2.0.</Description>
    <Summary>Cross-platform library for lightning location system data analysis and visualization</Summary>
    <PackageTags>lightning;meteorology;thunderstorm;data-analysis;visualization;gis;.net-standard;.net-framework;weather</PackageTags>
    <PackageProjectUrl>https://memoryfraction.github.io/LLSDA-Lightning-Location-System-Data-Analyzer/</PackageProjectUrl>
    <RepositoryUrl>https://github.com/memoryfraction/LLSDA-Lightning-Location-System-Data-Analyzer</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>GPL-3.0-only</PackageLicenseExpression>
    <PackageIcon>LLSDA-Icon.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <NeutralLanguage>en-US</NeutralLanguage>
    
    <!-- Assembly Versioning -->
    <AssemblyVersion>1.4.1.0</AssemblyVersion>
    <FileVersion>1.4.1.0</FileVersion>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <Folder Include="Interface\" />
    <Folder Include="Service\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="System.Drawing.Common" Version="8.0.19" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <Reference Include="System.Drawing" />
    <Reference Include="System" />
    <Reference Include="Microsoft.CSharp" />
  </ItemGroup>

  <!-- NuGet Package Files -->
  <ItemGroup>
    <None Include="..\..\Images\LLSDA-Icon.png" Pack="true" PackagePath="" />
    <None Include="license\license.txt" Pack="true" PackagePath="" />
    <None Include="..\..\README.md" Pack="true" PackagePath="" />
  </ItemGroup>

</Project>